rules_version = '2';
// Regras do Firestore — colar em: console Firebase → Firestore → Regras → Publicar
service cloud.firestore {
  match /databases/{db}/documents {

    // Admin = só quem entrou com Google usando estes e-mails.
    function isEquipe() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['suporte.ava@fatecivaipora.com.br', 'suporteavafatec@gmail.com'];
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function leadValido(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['origem', 'nome', 'whatsapp', 'cidade', 'consentimento', 'criadoEm'])
        && d.keys().hasOnly(['origem', 'nome', 'whatsapp', 'cidade', 'escola', 'curso', 'local',
                             'consentimento', 'criadoEm', 'cadastradoPor'])
        && d.origem in ['aulao-redacao-2026', 'enem-08-11', 'enem-15-11']
        && id == d.origem + '_' + d.whatsapp
        && d.whatsapp.matches('^[1-9][1-9]9[0-9]{8}$')
        && str(d.nome, 3, 120)
        && str(d.cidade, 2, 80)
        && (!('escola' in d) || str(d.escola, 2, 120))
        && (!('curso' in d) || str(d.curso, 1, 400))
        && (!('local' in d) || str(d.local, 1, 80))
        && d.consentimento == true
        && d.criadoEm == request.time
        && (!('cadastradoPor' in d) || (isEquipe() && d.cadastradoPor == request.auth.token.email));
    }


    // Marcador sem dados pessoais, para o "Já me inscrevi" conferir um número.
    // Só dá para consultar um id exato (get); listar continua proibido.
    match /inscritos/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['criadoEm'])
        && request.resource.data.criadoEm == request.time
        && existsAfter(/databases/$(db)/documents/leads/$(id))
        && !exists(/databases/$(db)/documents/leads/$(id));
    }

    match /leads/{id} {
      allow create: if leadValido(id);          // público: só cria, nunca lê
      allow read: if isEquipe();
      allow update: if isEquipe()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['presente', 'presenteEm', 'sorteado', 'sorteadoEm', 'sorteadoPor']);
      allow delete: if false;
    }
  }
}
